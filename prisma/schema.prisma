generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum Role {
  ADMIN
  COACH
  MEMBER
  GUEST
  ORG_ADMIN
}

enum MemberLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  COMPETITIVE_SQUAD
}

enum MemberStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING_PAYMENT
}

enum MembershipPlan {
  MONTHLY
  TERM
  ANNUAL
}

enum MembershipTier {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  COMPETITIVE_SQUAD
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum DonorType {
  INDIVIDUAL
  COMPANY
  ALUMNI
}

enum PaymentMethod {
  MPESA
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DonationCategory {
  TRAINING_EQUIPMENT
  TOURNAMENTS
  TRAVEL_SUPPORT
  GENERAL_FUND
}

enum OrganizationType {
  SCHOOL
  COMPANY
  ACADEMY
  CLUB
}

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChessInterest {
  BEGINNER_INTEREST
  ACTIVE_INTEREST
  COMPETITIVE_INTEREST
}

enum ParticipationType {
  TRAINING_PARTNERSHIP
  TOURNAMENT_ENTRY
  MEMBERSHIP_AFFILIATION
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

// ─── Core User ────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts         Post[]
  member        Member?
  registrations Registration[]
  results       Result[]
  donations     Donation[]
  auditLogs     AuditLog[]
  announcements Announcement[]
}

model Post {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String?
  category  String   @default("general")
  imageUrl  String?
  tags      String[]
  published Boolean  @default(false)
  authorId  String

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@index([category, published])
}

// ─── Member Profile ───────────────────────────────────────────

model Member {
  id               String         @id @default(uuid())
  userId           String         @unique
  level            MemberLevel    @default(BEGINNER)
  tier             MembershipTier @default(BEGINNER)
  rating           Int            @default(1200)
  status           MemberStatus   @default(PENDING)
  joinedAt         DateTime       @default(now())
  profilePhoto     String?
  trainingGroup    String?
  emergencyContact String?
  medicalNotes     String?
  autoRenew        Boolean        @default(false)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  results       Result[]
  memberships   Membership[]
  attendance    Attendance[]
  ratingHistory ChessRatingHistory[]

  @@index([status, rating])
  @@index([status])
  @@index([joinedAt])
}

// ─── Membership Subscription ──────────────────────────────────

model Membership {
  id        String         @id @default(uuid())
  memberId  String
  plan      MembershipPlan
  tier      MembershipTier
  startDate DateTime
  endDate   DateTime
  status    MemberStatus   @default(PENDING_PAYMENT)
  autoRenew Boolean        @default(false)
  amount    Float
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  member       Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([memberId, status])
  @@index([memberId, createdAt])
}

// ─── Events & Tournaments ─────────────────────────────────────

model Event {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  location    String
  startDate   DateTime
  endDate     DateTime
  capacity    Int      @default(32)
  type        String   @default("tournament")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations Registration[]
  results       Result[]
  attendance    Attendance[]

  @@index([startDate])
  @@index([startDate, type])
}

model Registration {
  id        String             @id @default(uuid())
  userId    String
  eventId   String
  status    RegistrationStatus @default(CONFIRMED)
  createdAt DateTime           @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, createdAt])
}

model Result {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  score     Float    @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [userId], references: [userId], map: "Result_member_userId_fkey")

  @@index([userId, createdAt])
  @@index([eventId])
}

model Attendance {
  id        String    @id @default(uuid())
  memberId  String
  eventId   String
  attended  Boolean   @default(false)
  checkedAt DateTime?
  createdAt DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId])
  @@index([memberId, attended])
}

model ChessRatingHistory {
  id        String   @id @default(uuid())
  memberId  String
  rating    Int
  reason    String?
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
}

// ─── Donations ────────────────────────────────────────────────

model Donation {
  id         String           @id @default(uuid())
  userId     String?
  donorType  DonorType        @default(INDIVIDUAL)
  donorName  String
  donorEmail String
  anonymous  Boolean          @default(false)
  amount     Float
  category   DonationCategory @default(GENERAL_FUND)
  message    String?
  dedication String?
  taxReceipt Boolean          @default(false)
  campaign   String?
  status     PaymentStatus    @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([status, createdAt])
}

// ─── Payment Transactions ─────────────────────────────────────

model PaymentTransaction {
  id                String        @id @default(uuid())
  donationId        String?
  membershipId      String?
  amount            Float
  method            PaymentMethod @default(MPESA)
  status            PaymentStatus @default(PENDING)
  phoneNumber       String?
  mpesaCode         String?
  mpesaReceiptNo    String?
  checkoutRequestId String?
  merchantRequestId String?
  failureReason     String?
  metadata          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  donation   Donation?   @relation(fields: [donationId], references: [id], onDelete: SetNull)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([donationId])
  @@index([membershipId])
  @@index([status])
}

// ─── Organizations ────────────────────────────────────────────

model Organization {
  id                  String             @id @default(uuid())
  name                String
  type                OrganizationType
  registrationNumber  String?
  location            String
  county              String?
  contactPerson       String
  contactRole         String?
  email               String             @unique
  phone               String
  memberCount         Int                @default(0)
  chessInterest       ChessInterest      @default(ACTIVE_INTEREST)
  participationType   ParticipationType  @default(MEMBERSHIP_AFFILIATION)
  trainingSchedule    String?
  status              OrganizationStatus @default(PENDING)
  assignedCoordinator String?
  notes               String?
  approvedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  members OrganizationMember[]

  @@index([status])
  @@index([createdAt])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  name           String
  email          String?
  role           String   @default("member")
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ─── Gallery ──────────────────────────────────────────────────

model GalleryItem {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String
  caption     String?
  category    String   @default("general")
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([category, createdAt])
}

// ─── Communication ────────────────────────────────────────────

model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  pinned      Boolean  @default(false)
  publishedAt DateTime @default(now())
  expiresAt   DateTime?
  authorId    String?
  createdAt   DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pinned, publishedAt])
  @@index([expiresAt])
}

// ─── Contact Messages ─────────────────────────────────────────

model ContactMessage {
  id        String               @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())

  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscription {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  active       Boolean  @default(true)

  @@index([active])
}

// ─── Site Settings ────────────────────────────────────────────

model SiteSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Audit Logs ───────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}
