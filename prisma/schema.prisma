generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/////////////////////////////////////////////////////
// USER
/////////////////////////////////////////////////////

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  member                   Member?
  registrations            Registration[]
  results                  Result[]
  posts                    Post[]
  donations                Donation[]
  subscriptions            Subscription[]
  paymentTransactions      PaymentTransaction[]
  organizationMemberships  OrganizationMember[]
  coordinatedOrganizations Organization[]         @relation("OrganizationCoordinator")
  organizedEvents          Event[]                @relation("EventOrganizer")
  coachedTrainingGroups    TrainingGroup[]        @relation("TrainingGroupCoach")
  attendanceRecords        Attendance[]
  recordedAttendances      Attendance[]           @relation("AttendanceRecorder")
  whitePairings            Pairing[]              @relation("WhitePairings")
  blackPairings            Pairing[]              @relation("BlackPairings")
  ratingHistory            ChessRatingHistory[]
  announcements            Announcement[]
  notificationLogs         NotificationLog[]
  auditLogs                AuditLog[]             @relation("AuditActor")
  dataConsents             DataConsent[]
  bulkUploads              BulkUpload[]           @relation("BulkUploadUser")
}

/////////////////////////////////////////////////////
// MEMBER PROFILE
/////////////////////////////////////////////////////

model Member {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  level    MembershipLevel @default(BEGINNER)
  rating   Int             @default(1200)
  status   MemberStatus    @default(PENDING)
  joinedAt DateTime        @default(now())

  profilePhotoUrl       String?
  eloRating             Int?
  internalRating        Int       @default(1200)
  attendancePercentage  Float     @default(0)
  medicalNotes          String?
  emergencyContactName  String?
  emergencyContactPhone String?
  guardianName          String?
  guardianPhone         String?
  dateOfBirth           DateTime?

  familyAccount   FamilyAccount? @relation(fields: [familyAccountId], references: [id])
  familyAccountId String?

  trainingGroup   TrainingGroup? @relation(fields: [trainingGroupId], references: [id])
  trainingGroupId String?

  memberships             Membership[]
  subscriptions           Subscription[]
  organizationMemberships OrganizationMember[]
  attendanceRecords       Attendance[]
  ratingHistory           ChessRatingHistory[]
  achievements            MemberAchievement[]
  paymentTransactions     PaymentTransaction[]
}

model FamilyAccount {
  id                   String   @id @default(cuid())
  name                 String
  primaryGuardianName  String
  primaryGuardianEmail String
  primaryGuardianPhone String?
  billingEmail         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members       Member[]
  memberships   Membership[]
  subscriptions Subscription[]
}

model Membership {
  id       String @id @default(cuid())
  member   Member @relation(fields: [memberId], references: [id])
  memberId String

  familyAccount   FamilyAccount? @relation(fields: [familyAccountId], references: [id])
  familyAccountId String?

  tier            MembershipTier   @default(BEGINNER)
  status          MembershipStatus @default(PENDING_PAYMENT)
  plan            SubscriptionPlan @default(MONTHLY)
  startsAt        DateTime         @default(now())
  expiresAt       DateTime?
  gracePeriodDays Int              @default(7)
  gracePeriodEndsAt DateTime?
  autoRenew       Boolean          @default(false)

  trainingGroup   TrainingGroup? @relation(fields: [trainingGroupId], references: [id])
  trainingGroupId String?

  subscriptions       Subscription[]
  paymentTransactions PaymentTransaction[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([memberId, status])
}

model Subscription {
  id String @id @default(cuid())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  member   Member? @relation(fields: [memberId], references: [id])
  memberId String?

  membership   Membership? @relation(fields: [membershipId], references: [id])
  membershipId String?

  familyAccount   FamilyAccount? @relation(fields: [familyAccountId], references: [id])
  familyAccountId String?

  plan            SubscriptionPlan   @default(MONTHLY)
  tier            MembershipTier     @default(BEGINNER)
  status          SubscriptionStatus @default(PENDING_PAYMENT)
  amount          Decimal            @db.Decimal(10, 2)
  currency        String             @default("KES")
  autoRenew       Boolean            @default(false)
  startDate       DateTime           @default(now())
  endDate         DateTime?
  nextBillingDate DateTime?
  gracePeriodDays Int                @default(7)
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  paymentTransactions PaymentTransaction[]
  renewalReminders    RenewalReminder[]
  notificationLogs    NotificationLog[]

  @@index([status, endDate])
  @@index([memberId])
}

/////////////////////////////////////////////////////
// ORGANIZATIONS
/////////////////////////////////////////////////////

model Organization {
  id                 String                @id @default(cuid())
  name               String
  type               OrganizationType
  registrationNumber String?
  county             String?
  city               String?
  address            String?
  contactPersonName  String
  contactPersonRole  String
  email              String
  phone              String
  memberCount        Int                   @default(0)
  interestLevel      ChessInterestLevel    @default(BEGINNER)
  participationType  ParticipationType     @default(TRAINING_PARTNERSHIP)
  status             OrganizationStatus    @default(PENDING)
  approvedAt         DateTime?
  rejectedAt         DateTime?
  preferredTrainingSchedule String?
  competitionHistory String?
  billingEmail       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  coordinator   User?   @relation("OrganizationCoordinator", fields: [coordinatorId], references: [id])
  coordinatorId String?

  members             OrganizationMember[]
  teams               TrainingGroup[]
  bulkUploads         BulkUpload[]
  paymentTransactions PaymentTransaction[]
  attendanceRecords   Attendance[]
  announcements       Announcement[]

  @@index([status, type])
}

model OrganizationMember {
  id             String @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  member   Member? @relation(fields: [memberId], references: [id])
  memberId String?

  group   TrainingGroup? @relation(fields: [groupId], references: [id])
  groupId String?

  name     String?
  email    String?
  role     OrganizationMemberRole @default(MEMBER)
  joinedAt DateTime               @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId, role])
}

model TrainingGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  schedule    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  coach   User?   @relation("TrainingGroupCoach", fields: [coachId], references: [id])
  coachId String?

  members             Member[]
  memberships         Membership[]
  organizationMembers OrganizationMember[]
  announcements       Announcement[]
}

model BulkUpload {
  id             String           @id @default(cuid())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  organizationId String
  uploadedBy     User?            @relation("BulkUploadUser", fields: [uploadedById], references: [id])
  uploadedById   String?
  filename       String
  status         BulkUploadStatus @default(PENDING)
  totalRows      Int              @default(0)
  successRows    Int              @default(0)
  errorRows      Int              @default(0)
  errorReportUrl String?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?
}

/////////////////////////////////////////////////////
// EVENTS / TOURNAMENTS
/////////////////////////////////////////////////////

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  location    String
  startDate   DateTime
  endDate     DateTime
  capacity    Int       @default(32)
  type        EventType @default(CLUB_EVENT)
  format      TournamentFormat?
  published   Boolean   @default(true)
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizer   User?   @relation("EventOrganizer", fields: [organizerId], references: [id])
  organizerId String?

  registrations Registration[]
  results       Result[]
  attendance    Attendance[]
  pairings      Pairing[]
  ratingHistory ChessRatingHistory[]
  achievements  MemberAchievement[]
}

model Registration {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String

  status    RegistrationStatus @default(PENDING)
  createdAt DateTime           @default(now())

  @@unique([userId, eventId])
}

model Attendance {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  member   Member? @relation(fields: [memberId], references: [id])
  memberId String?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  recordedBy   User?   @relation("AttendanceRecorder", fields: [recordedById], references: [id])
  recordedById String?

  status      AttendanceStatus @default(PRESENT)
  checkedInAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())

  @@unique([eventId, userId])
  @@unique([eventId, memberId])
  @@index([eventId, status])
}

model Pairing {
  id          String @id @default(cuid())
  event       Event  @relation(fields: [eventId], references: [id])
  eventId     String
  round       Int
  boardNumber Int

  whiteUser   User  @relation("WhitePairings", fields: [whiteUserId], references: [id])
  whiteUserId String

  blackUser   User?   @relation("BlackPairings", fields: [blackUserId], references: [id])
  blackUserId String?

  result      PairingResult @default(PENDING)
  scheduledAt DateTime?
  createdAt   DateTime      @default(now())

  @@unique([eventId, round, boardNumber])
}

model Result {
  id String @id @default(cuid())

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  score  Float @default(0)
  wins   Int   @default(0)
  losses Int   @default(0)
  draws  Int   @default(0)

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model ChessRatingHistory {
  id String @id @default(cuid())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  member   Member? @relation(fields: [memberId], references: [id])
  memberId String?

  event   Event?  @relation(fields: [eventId], references: [id])
  eventId String?

  ratingType     RatingType @default(INTERNAL)
  rating         Int
  previousRating Int?
  change         Int?
  source         String?
  createdAt      DateTime   @default(now())

  @@index([memberId, ratingType, createdAt])
}

model MemberAchievement {
  id       String @id @default(cuid())
  member   Member @relation(fields: [memberId], references: [id])
  memberId String

  event   Event?  @relation(fields: [eventId], references: [id])
  eventId String?

  title       String
  description String?
  awardedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
}

/////////////////////////////////////////////////////
// DONATIONS / PAYMENTS
/////////////////////////////////////////////////////

model DonationCampaign {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  description String?
  category    DonationCategory @default(GENERAL_FUND)
  goalAmount  Decimal?         @db.Decimal(10, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  donations Donation[]
}

model Donation {
  id String @id @default(cuid())

  donor   User?   @relation(fields: [donorUserId], references: [id])
  donorUserId String?

  campaign   DonationCampaign? @relation(fields: [campaignId], references: [id])
  campaignId String?

  donorName           String?
  donorEmail          String?
  donorType           DonorType         @default(INDIVIDUAL)
  category            DonationCategory @default(GENERAL_FUND)
  amount              Decimal          @db.Decimal(10, 2)
  currency            String           @default("KES")
  paymentMethod       PaymentMethod    @default(MPESA)
  frequency           DonationFrequency @default(ONE_TIME)
  status              PaymentStatus    @default(PENDING)
  anonymous           Boolean          @default(false)
  leaderboardOptIn    Boolean          @default(true)
  message             String?
  taxReceiptRequested Boolean          @default(false)
  receiptNumber       String?          @unique
  receiptUrl          String?
  receiptEmailSentAt  DateTime?
  startedAt           DateTime         @default(now())
  nextBillingAt       DateTime?
  endedAt             DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  paymentTransactions PaymentTransaction[]

  @@index([category, status])
  @@index([campaignId])
}

model PaymentTransaction {
  id String @id @default(cuid())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  member   Member? @relation(fields: [memberId], references: [id])
  memberId String?

  membership   Membership? @relation(fields: [membershipId], references: [id])
  membershipId String?

  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?

  donation   Donation? @relation(fields: [donationId], references: [id])
  donationId String?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("KES")
  method            PaymentMethod @default(MPESA)
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerReference String?       @unique
  checkoutRequestId String?
  mpesaReceiptNumber String?
  description       String?
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, method])
  @@index([userId])
  @@index([memberId])
}

/////////////////////////////////////////////////////
// POSTS (NEWS / BLOG)
/////////////////////////////////////////////////////

model Post {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  excerpt String
  content String

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/////////////////////////////////////////////////////
// GALLERY
/////////////////////////////////////////////////////

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
}

/////////////////////////////////////////////////////
// COMMUNICATION / SAFETY
/////////////////////////////////////////////////////

model Announcement {
  id        String               @id @default(cuid())
  title     String
  message   String
  audience  AnnouncementAudience @default(ALL)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  publishedAt DateTime?

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  trainingGroup   TrainingGroup? @relation(fields: [trainingGroupId], references: [id])
  trainingGroupId String?
}

model NotificationLog {
  id String @id @default(cuid())

  recipient   User?   @relation(fields: [recipientId], references: [id])
  recipientId String?

  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?

  channel      NotificationChannel
  type         NotificationType
  status       NotificationStatus @default(PENDING)
  destination  String
  subject      String?
  message      String
  scheduledFor DateTime?
  sentAt       DateTime?
  providerRef  String?
  createdAt    DateTime           @default(now())

  @@index([status, channel])
}

model RenewalReminder {
  id             String              @id @default(cuid())
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id])
  subscriptionId String
  channel        NotificationChannel
  scheduledFor   DateTime
  sentAt         DateTime?
  status         NotificationStatus  @default(PENDING)
  createdAt      DateTime            @default(now())

  @@index([subscriptionId, scheduledFor])
}

model AuditLog {
  id String @id @default(cuid())

  actor   User?   @relation("AuditActor", fields: [actorId], references: [id])
  actorId String?

  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model DataConsent {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  type      DataConsentType
  granted   Boolean         @default(false)
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, type])
}

/////////////////////////////////////////////////////
// CONTACT
/////////////////////////////////////////////////////

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

/////////////////////////////////////////////////////
// ENUMS
/////////////////////////////////////////////////////

enum Role {
  ADMIN
  COACH
  MEMBER
  ORGANIZATION_ADMIN
  GUEST
}

enum MembershipLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  COMPETITIVE_SQUAD
  MASTER
}

enum MembershipTier {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  COMPETITIVE_SQUAD
  FAMILY
}

enum MemberStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING_PAYMENT
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING_PAYMENT
  CANCELLED
}

enum SubscriptionPlan {
  MONTHLY
  TERM
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING_PAYMENT
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum DonationCategory {
  TRAINING_EQUIPMENT
  TOURNAMENTS
  TRAVEL_SUPPORT
  GENERAL_FUND
}

enum DonorType {
  INDIVIDUAL
  COMPANY
  ALUMNI
}

enum DonationFrequency {
  ONE_TIME
  MONTHLY
}

enum PaymentMethod {
  MPESA
  CARD
  BANK_TRANSFER
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum OrganizationType {
  SCHOOL
  COMPANY
  ACADEMY
  CLUB
}

enum ChessInterestLevel {
  BEGINNER
  ACTIVE
  COMPETITIVE
}

enum ParticipationType {
  TRAINING_PARTNERSHIP
  TOURNAMENT_ENTRY
  MEMBERSHIP_AFFILIATION
}

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrganizationMemberRole {
  MEMBER
  STUDENT
  PARENT
  COACH
  CAPTAIN
  ORGANIZATION_ADMIN
}

enum BulkUploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EventType {
  CLUB_EVENT
  TOURNAMENT
  TRAINING
  SCHOOL_VISIT
  ORGANIZATION_EVENT
}

enum TournamentFormat {
  SWISS
  ROUND_ROBIN
  KNOCKOUT
  ARENA
  MATCH
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PairingResult {
  PENDING
  WHITE_WIN
  BLACK_WIN
  DRAW
  BYE
  FORFEIT
}

enum RatingType {
  ELO
  INTERNAL
}

enum AnnouncementAudience {
  ALL
  MEMBERS
  COACHES
  ORGANIZATION
  GROUP
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationType {
  RENEWAL_REMINDER
  EVENT_REMINDER
  ANNOUNCEMENT
  PAYMENT_RECEIPT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum DataConsentType {
  TERMS
  PRIVACY
  MEDIA_CONSENT
  MEDICAL_INFORMATION
  COMMUNICATIONS
}
