{
  "name": "zaidknights-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:fix-env": "node scripts/fix-supabase-env.mjs",
    "prisma:fix-env:pooler": "node scripts/fix-supabase-env.mjs --pooler-only",
    "prisma:check": "node scripts/check-supabase-connection.mjs",
    "prisma:deploy": "prisma validate && prisma migrate deploy && prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:smoke": "node scripts/prisma-smoke.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.4.7",
    "next": "^15.0.0",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
